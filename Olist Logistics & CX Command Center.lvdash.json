{
  "datasets": [
    {
      "name": "00c1635d",
      "displayName": "Dataset_KPIs",
      "queryLines": [
        "SELECT\r\n",
        "  SUM(total_value) as Receita_Total,\r\n",
        "  COUNT(DISTINCT order_id) as Total_Pedidos,\r\n",
        "  ROUND((1 - AVG(is_late_delivery)), 4) as Taxa_Entrega_No_Prazo\r\n",
        "FROM olist_portfolio.gold.fact_sales"
      ]
    },
    {
      "name": "9d9ce137",
      "displayName": "Mapa_de_vendas",
      "queryLines": [
        "SELECT\r\n",
        "  concat('BR-', c.customer_state) as Estado,\r\n",
        "  COUNT(DISTINCT f.order_id) as Quantidade_Pedidos,\r\n",
        "  SUM(f.total_value) as Valor_Vendas\r\n",
        "FROM olist_portfolio.gold.fact_sales f\r\n",
        "JOIN olist_portfolio.silver.customers c ON f.customer_id = c.customer_id\r\n",
        "GROUP BY c.customer_state"
      ]
    },
    {
      "name": "86182011",
      "displayName": "Analise_de_sentimentos",
      "queryLines": [
        "SELECT \r\n",
        "  product_category_name as Categoria,\r\n",
        "  COUNT(*) as Total_Reviews,\r\n",
        "  SUM(CASE WHEN sentiment_label = 'negativo' THEN 1 ELSE 0 END) as Qtd_Negativos,\r\n",
        "  ROUND((SUM(CASE WHEN sentiment_label = 'negativo' THEN 1 ELSE 0 END) / COUNT(*)), 2) as Taxa_Reprovacao\r\n",
        "FROM olist_portfolio.gold.reviews_analytics\r\n",
        "WHERE product_category_name IS NOT NULL\r\n",
        "GROUP BY product_category_name\r\n",
        "HAVING COUNT(*) > 50 \r\n",
        "ORDER BY Taxa_Reprovacao DESC\r\n",
        "LIMIT 15"
      ]
    }
  ],
